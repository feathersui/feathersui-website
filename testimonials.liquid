      <div class="section-column-img"><img src="{{item.image}}"></div>
      <h2>{{item.title}}</h2>
      <p>{{item.content}}</p>
      <cite>{{item.author}}</cite>
    </div>
    {% endfor %}
  </div>
</section>

<section class="section-img section-img-right">
  <div class="section-row">
    <img src="/img/undraw_product_teardown_elol.svg">
    <div>
      <h2>Give Feathers UI a try!</h2>
      <p>Start building apps for mobile, desktop, and web browsers using dozens of stunning, GPU-accelerated UI components.</p>
      <div class="btn-wrapper">
        <a class="btn btn-cta" href="/learn/haxe-openfl/getting-started/">Getting Started</a>
        <a class="btn" href="/learn/haxe-openfl/installation">Download →</a>
      </div>
    </div>
  </div>
</section>